{
  "manifest_version": 3,
  "name": "TileTV",
  "version": "1.0.0",
  "description": "Multiview for YouTube TV: watch up to four streams side by side in one tab, and pick which ones you hear.",
  "permissions": ["declarativeNetRequestWithHostAccess", "storage", "tabs"],
  "host_permissions": ["https://tv.youtube.com/*"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open TileTV", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "content_scripts": [
    {
      "matches": ["https://tv.youtube.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
